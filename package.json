{
  "name": "al-muhtaraz-containers",
  "version": "1.0.3",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:desktop": "node scripts/build-desktop.cjs",
    "start": "next start",
    "lint": "eslint src",
    "check-links": "npx tsx scripts/health-check.ts",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "npm run build:desktop && electron .",
    "desktop:pack": "npm run build:desktop && electron-builder --dir",
    "desktop:installer": "npm run build:desktop && electron-builder --win nsis --publish never",
    "desktop:smoke": "node scripts/smoke-desktop.cjs dist/win-unpacked",
    "desktop:smoke:crash": "node scripts/smoke-desktop.cjs dist/win-unpacked --crash-server",
    "test:update-manifest": "node --test scripts/update-manifest.test.cjs scripts/release-key.test.cjs",
    "release:metadata": "node scripts/create-release-metadata.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.48.0",
    "canvas-confetti": "^1.9.4",
    "edge-tts": "^1.0.1",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^0.475.0",
    "msedge-tts": "^2.0.7",
    "next": "^15.1.7",
    "openai": "^7.8.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollbar": "^4.2.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.23",
    "typescript": "^5.7.3"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.almuhtaraz.containers",
    "productName": "المحترز للحاويات",
    "asar": true,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "asarUnpack": [
      ".next/standalone/**"
    ],
    "files": [
      "electron/main.cjs",
      "electron/updateManifest.cjs",
      "electron/updatePublicKey.cjs",
      "package.json",
      ".next/standalone/**/*",
      "!node_modules/**"
    ],
    "win": {
      "artifactName": "Al-Muhtaraz-Setup-${version}.${ext}",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      },
      "target": [
        "dir",
        "nsis"
      ]
    }
  }
}
